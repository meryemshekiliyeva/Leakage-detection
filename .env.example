# Smart Water AI - environment configuration
#
# By default the dashboard connects to the Arduino DIRECTLY over USB using the
# browser's Web Serial API (Chrome/Edge). No configuration is needed for that —
# just click "Connect Arduino" in the app.
#
# The variable below is OPTIONAL and only for the future Raspberry Pi setup:
# if you later run the Python bridge in raspberry-pi/, point the dashboard at it
# here and it will use that live feed automatically.
#
# VITE_LIVE_API_URL=http://raspberrypi.local:8000
